<?xml version="1.0" encoding="utf-8"?>
<!-- También en la HD: los juegos de MS-DOS de los extras (DOSBox Pure, libdos.so). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name=".DosActivity"
            android:process=":dos"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:preferMinimalPostProcessing="true"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation" />
        <activity
            android:name=".PsxActivity"
            android:process=":psx"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:preferMinimalPostProcessing="true"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation" />
        <!-- Duke Nukem 3D Classic (EDuke32 por software, libeduke32.so), en su propio proceso. -->
        <activity
            android:name=".classic.GameActivity"
            android:process=":classic"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:preferMinimalPostProcessing="true"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation" />
    </application>
</manifest>
